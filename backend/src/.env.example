# PostgreSQL connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=
DB_USER=
DB_PASSWORD=

# JWT settings
JWT_KEY=
JWT_ISSUER=GovServiceNavigator
JWT_AUDIENCE=GovServiceNavigatorClients
JWT_EXPIRY_HOURS=24

# ASP.NET Core environment
ASPNETCORE_ENVIRONMENT=Development

# DataBase Migration PG local to neonDB
DATABASE_URL=<your_neon_database_url>

# STRIPE
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx 

# SMTP settings for email notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Government Service Navigator
SMTP_USE_SSL=true

# Performance (docs/performance-and-redis.md)
# Use Neon's *pooled* connection string for DATABASE_URL (the host contains "-pooler").
# Npgsql pool cap per API instance.
DB_MAX_POOL_SIZE=50
# Requests per minute per user (citizen NIC / officer email / IP) before 429.
RATE_LIMIT_PER_MINUTE=120
# Redis (optional). Leave empty to run with the in-memory cache only (single API instance).
# Local: docker compose -f docker-compose.redis.yml up -d  ->  REDIS_URL=localhost:6379
# Hosted example: REDIS_URL=your-host.upstash.io:6379,password=xxxx,ssl=True,abortConnect=False
REDIS_URL=
